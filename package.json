{
    "name": "sizdah-marketing",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:cpanel": "bash scripts/package-cpanel.sh",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:parspack": "HEADED=1 playwright test --config=playwright.parspack.config.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^22.10.0",
        "autoprefixer": "^10.6.2",
        "concurrently": "^9.1.0",
        "eslint": "^10.8.0",
        "laravel-vite-plugin": "^1.1.1",
        "postcss": "^8.5.33",
        "postcss-nesting": "^14.0.3",
        "prettier": "^3.4.1",
        "tailwindcss": "^3.4.19",
        "tailwindcss-logical": "^3.0.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.3",
        "typescript-eslint": "^8.48.0"
    },
    "dependencies": {
        "flag-icons": "^7.5.0",
        "gsap": "^3.12.5"
    }
}
